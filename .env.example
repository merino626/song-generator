# Copy to .env.local and fill in your own values.
# Everything here is a placeholder — no real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- crun.ai (music/lyrics engine) ---
CRUN_API_KEY=
CRUN_BASE_URL=https://api.crun.ai
CRUN_MUSIC_VERSION=v5.5

# --- Cloudflare R2 (media storage) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Stripe (payments) ---
# Use your sk_test_/pk_test_ keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From your webhook endpoint's settings — optional locally (falls back to
# re-verifying against Stripe's API), required in production.
STRIPE_WEBHOOK_SECRET=

# --- Internal secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
ADMIN_SECRET=

# Public URL (used for crun.ai's callback and Turnstile's localhost check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails exempt from the daily lyric-generation rate limit
LIMIT_ALLOWLIST_EMAILS=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to 1 to use Cloudflare's always-pass demo keys for local/E2E testing.
# Only takes effect when NEXT_PUBLIC_SITE_URL is localhost.
NEXT_PUBLIC_TURNSTILE_TEST=0

# Global daily cap on lyric generations (cost control)
LIMIT_GLOBAL_DAY=1500
